# .env.example — шаблон секретов и переопределений Моники (P0).
# Скопируй в .env (уже в .gitignore) и заполни РЕАЛЬНЫМИ значениями.
# .env никогда не попадает в git и в backup-архивы.

# ── Секреты (обязательно/по необходимости) ──

# Машинный секрет: шифрование ключей пользователей (keys.enc).
# СМЕНА этого значения делает существующие keys.enc нечитаемыми —
# сохраняй отдельно и бэкапь.
MONICA_MACHINE_SECRET=

# Telegram-бот (если используется)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет webhook-пути: обязателен для webhook-транспорта (HTTPS + PUBLIC_APP_URL)
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-URL приложения (для webhook и команды /open)
PUBLIC_APP_URL=

# ── Серверные fallback LLM-ключи (опционально) ──
# Используются, только если у пользователя нет своего ключа сервиса.
# Никогда не отправляются в браузер.
GLM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Не-секретные переопределения (опционально) ──

# Каталог mutable-данных (users/, telegram/, sessions/, audit/, backups/, tmp/)
MONICA_DATA_DIR=

# Хост/порт сервера (локально по умолчанию 127.0.0.1:8900;
# в Docker — 0.0.0.0)
MONICA_HOST=
PORT=

# Явный флаг dev-polling Telegram (1/true) — только для разработки.
# В production используй webhook. Polling и webhook одновременно — запрещено.
# TELEGRAM_DEV_POLLING=
